# ==============================================================================
# LumaChat Environment Variables (.env.example)
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual API keys or secrets to version control.
# ==============================================================================

# Admin Passcode configuration
# Fallback passcode for the primary admin operator account (defaults to ADMIN123 if unset)
ADMIN_CODE=your_secure_admin_passcode_here

# Session & Token Signing Secret
# Strong random secret key used to sign session cookies and CSRF tokens in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_long_random_auth_secret_key_here

# Upstash Redis / Vercel KV REST API Credentials (Primary Database Storage)
# Required for production persistence across serverless executions.
# In local development without these variables, LumaChat falls back to local file storage.
KV_REST_API_URL=https://your-upstash-redis-endpoint.upstash.io
KV_REST_API_TOKEN=your_upstash_redis_rest_token_here

# Alternative naming supported by Upstash Redis clients:
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Camouflage / Disguise Mode Settings
# Target URL rendered in full-screen iframe when the disguise trigger code (@1234) is entered.
NEXT_PUBLIC_DISGUISE_URL=https://beauty-n-joy-demo.pixelworks.workers.dev/
